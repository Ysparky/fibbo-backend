generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  role      UserRole
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])
  votes     Vote[]
  
  @@map("users")
}

model Session {
  id            String   @id @default(uuid())
  name          String
  moderatorId   String
  currentTaskId String?
  isVotingActive Boolean @default(false)
  participants  User[]
  tasks         Task[]
  
  @@map("sessions")
}

model Task {
  id            String   @id @default(uuid())
  title         String
  description   String
  sessionId     String
  finalEstimate Float?
  session       Session  @relation(fields: [sessionId], references: [id])
  votes         Vote[]
  
  @@map("tasks")
}

model Vote {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  value     Float
  timestamp DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  
  @@map("votes")
}

enum UserRole {
  MODERATOR
  PARTICIPANT
} 